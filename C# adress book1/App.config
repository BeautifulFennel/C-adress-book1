<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="AddressBook"
         connectionString="Server=localhost;Port=3306;Database=addressbook;User ID=root;Password=;Character Set=utf8;Allow Zero Datetime=true;"
         providerName="MySqlConnector" />
  </connectionStrings>
  <appSettings>
    <add key="PERFORM_LONG_UI_CHECKS" value="false" />
  </appSettings>
</configuration>
